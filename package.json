{
  "name": "zotero-bibliometero",
  "type": "module",
  "version": "0.0.1",
  "description": "A Zotero 9 plugin that visualizes your library as an interactive force-directed knowledge graph: connect items by related links, shared authors, or shared tags. Dependency-free.",
  "config": {
    "addonName": "Zotero Bibliometero",
    "addonID": "zotero-bibliometero@jose.local",
    "addonRef": "zoterobibliometero",
    "addonInstance": "ZoteroBibliometero",
    "prefsPrefix": "extensions.zotero.zoterobibliometero"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josesiqueira/zotero-bibliometero.git"
  },
  "author": "josesiqueira",
  "bugs": {
    "url": "https://github.com/josesiqueira/zotero-bibliometero/issues"
  },
  "homepage": "https://github.com/josesiqueira/zotero-bibliometero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
